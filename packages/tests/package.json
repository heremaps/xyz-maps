{
  "name": "@here/xyz-maps-test",
  "version": "0.46.1",
  "description": "Tests for XYZ editor.",
  "author": {
    "name": "HERE Europe B.V.",
    "url": "https://here.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/heremaps/xyz-maps.git",
    "directory": "packages/tests"
  },
  "private": true,
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"specs/**/*.ts\" \"vitest/**/*.{ts,mts}\" \"*.mts\"",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:isolation": "vitest run --config vitest.isolation.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --skipLibCheck && tsc -p tsconfig.vitest.json"
  },
  "devDependencies": {
    "@here/xyz-maps-common": "workspace:^",
    "@here/xyz-maps-core": "workspace:^",
    "@here/xyz-maps-display": "workspace:^",
    "@here/xyz-maps-editor": "workspace:^",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

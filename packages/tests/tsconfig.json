{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "rootDir": "..",
    "outDir": "dist",
    "lib": ["ES2019", "dom"],
    "sourceMap": true,
    "allowJs": true,
    "types" : ["@vitest/browser-playwright"],
    "baseUrl": ".",
    "paths": {
      "@here/xyz-maps-*": ["../*/src"],
      "@test/*": ["src/*"],
      "vitest/browser": ["node_modules/vitest/browser/context.d.ts"],
      "vitest/internal/browser": ["node_modules/vitest/dist/browser.d.ts"],
      "*": ["src/utils/*"],
      "TestProviders": ["src/TestProvider.ts"]
    },
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "specs/**/*", "src/**/*", "vitest/setup.ts", "vitest/env.d.ts"
  ],
  "exclude": [
    "specs/buffers",
    "specs/unit/performance",
    "node_modules",
    "dist"
  ]
}

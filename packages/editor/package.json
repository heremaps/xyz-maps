    "build-release": "tsc --noEmit && rolldown -c rolldown.config.mjs --environment BUILD:production",
    "build-dts": "npx build-dts -p .",
    "update-changelog": "npx build-changelog"
  },
  "dependencies": {
    "@here/xyz-maps-common": "^0.46.1",
    "@here/xyz-maps-core": "^0.46.1",
    "@here/xyz-maps-display": "^0.46.1"
  },
  "devDependencies": {
    "rollup-plugin-img": "^1.1.0",
    "rolldown": "^1.2.14",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3"
  },
  "gitHead": "45c1cfc050f2fd86d9540dfff1aed75acedb27fa"

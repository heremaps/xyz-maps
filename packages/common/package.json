{
  "name": "@here/xyz-maps-common",
  "version": "0.47.0",
  "description": "Commonly used libraries of XYZ Maps.",
  "author": {
    "name": "HERE Europe B.V.",
    "url": "https://here.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/heremaps/xyz-maps.git",
    "directory": "packages/common"
  },
  "main": "dist/xyz-maps-common.min.js",
  "module": "dist/xyz-maps-common.esm.min.js",
  "types": "dist/xyz-maps-common.d.ts",
  "files": [
    "dist/xyz*.min.js",
    "dist/xyz-maps-common.d.ts"
  ],
  "scripts": {
    "watch-dev": "rolldown -c rolldown.config.mjs --watch --environment BUILD:dev",
    "build-dev": "tsc --noEmit && rolldown -c rolldown.config.mjs --environment BUILD:dev",
    "build-release": "tsc --noEmit && rolldown -c rolldown.config.mjs --environment BUILD:production",
    "build-dts": "npx build-dts -p .",
    "update-changelog": "npx build-changelog"
  },
  "browser": {},
  "publishConfig": {},
  "devDependencies": {
    "rolldown": "^1.2.14",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3"
  },
  "gitHead": "45c1cfc050f2fd86d9540dfff1aed75acedb27fa"
}

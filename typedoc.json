{
  "name": "XYZ Maps Documentation",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/display", "packages/core", "packages/editor"],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "skipErrorChecking": true,
    "exclude": ["**/*.spec.ts"],
    "disableSources": true,
    "excludePrivate": true,
    "excludeExternals": true,
    "excludeNotDocumented": true
  },
  "out": "docs",
  "theme": "default",
  "plugin": ["typedoc-plugin-remove-references"]
}
